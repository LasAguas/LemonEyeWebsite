# Stripe — server-side secret key (NEVER expose this in frontend code)
# Get yours at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Stripe — publishable key (safe to expose, used in frontend if needed)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe — webhook signing secret (for verifying Stripe events, optional for now)
# Create one at https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
